# Copy to .env.local and fill in. Never commit the copy.

# Public URL of the site, used for canonical links, sitemap and Open Graph.
# Local default below; in production, the real domain with https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Resend). If any of these is missing, the API answers 503 and names the missing ones.
# API key from https://resend.com/api-keys ("Sending access" is enough).
# Starts with "re_" and is about 36 characters; copy the whole thing, it is shown only once.
RESEND_API_KEY=
# Full email address that receives the messages, e.g. you@gmail.com.
CONTACT_TO_EMAIL=
# Sender shown on the email, as "Name <address>". The address's domain must be verified at
# https://resend.com/domains. Until then use "Portfolio <onboarding@resend.dev>", which can
# only deliver to the email of your Resend account.
CONTACT_FROM_EMAIL=
