# Public URL of the deployed site, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Resend). Without these the API answers 503 and the form shows an error.
RESEND_API_KEY=
# Address that receives contact messages.
CONTACT_TO_EMAIL=
# Verified Resend sender, e.g. "Portfolio <contact@your-domain.com>".
CONTACT_FROM_EMAIL=
